# Copy this file to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables for production.

# Public URL of the live site (used for SEO tags, sitemap and structured data).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Gmail SMTP for form submissions + auto-reply emails.
# SMTP_PASS must be a Gmail *App Password* (Google Account → Security →
# 2-Step Verification → App passwords), NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rixafit2024@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where new enquiries are delivered (defaults to the email in data/site.js).
MAIL_TO=rixafit2024@gmail.com
# Sender name shown in the inbox.
MAIL_FROM_NAME=RIXA FIT
