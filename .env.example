# Copy this file to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables for production.

# Public URL of the live site (used for SEO tags, sitemap and structured data).
# Optional: production builds already default to https://rixafit.com (data/site.js).
NEXT_PUBLIC_SITE_URL=https://rixafit.com

# Outgoing email for form notifications + auto-replies, sent from the official
# mailbox (GoDaddy Professional Email powered by Titan).
# SMTP_PASS is the info@rixafit.com mailbox password (the one used to log in to webmail).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@rixafit.com
SMTP_PASS=your-mailbox-password

# Optional: search engine ownership verification (HTML-tag method). Paste only the
# content="..." value from Google Search Console / Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Tag Manager is built in (data/site.js -> gtmId). Set GA4 up inside Tag Manager.
# Only if NOT using Tag Manager for GA4: measurement ID, e.g. G-XXXXXXXXXX (else visits count twice).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Where new enquiries are delivered (defaults to info@rixafit.com from data/site.js).
# Several inboxes can be comma-separated, e.g. "info@rixafit.com, owner@example.com".
MAIL_TO=info@rixafit.com
# Sender name shown in the inbox.
MAIL_FROM_NAME=RIXA FIT
